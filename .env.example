# Copie ce fichier en .env.local pour travailler en local.
# En ligne, ces valeurs se saisissent dans Vercel (Settings > Environment Variables).
# Ne jamais commiter de vraies valeurs.

# Claude (moteur d'écriture), côté serveur uniquement
ANTHROPIC_API_KEY=
# Facultatif : le modèle Claude à utiliser (un Sonnet récent par défaut)
CLAUDE_MODEL=

# Airtable, lecture seule, côté serveur uniquement
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appXzGMlNyLLQeRwY

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement : ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Emails autorisés à se connecter, séparés par des virgules
ALLOWED_EMAILS=prenom@exemple.fr,autre@exemple.fr
